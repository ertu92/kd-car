# Email Configuration
# Copy this file to .env.local and fill in your actual values

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: Custom from address (if different from SMTP_USER)
SMTP_FROM=noreply@kd-car.de

# Contact email where form submissions will be sent
CONTACT_EMAIL=inf@kd-car.de

# Note: For Gmail, you need to use an App Password, not your regular password
# Enable 2FA and generate an App Password in your Google Account settings

# CARMS inventory service
CARMS_BASE_URL=https://carms.example.com/api/public
CARMS_API_KEY=your-api-key


# Google Ads Conversion-Tracking (optional, ohne diese Werte wird kein Tag geladen)
# Konversions-ID aus Google Ads -> Zielvorhaben -> Conversions -> Tag einrichten
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Conversion-Labels (je Conversion-Aktion), optional
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
